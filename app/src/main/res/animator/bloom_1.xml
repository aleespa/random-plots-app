<?xml version="1.0" encoding="utf-8"?>
<!-- Splash bloom, square 1 of 5 (innermost first): grows out of the centre. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:duration="510"
        android:startOffset="0"
        android:interpolator="@interpolator/bloom_overshoot"
        android:propertyName="scaleX"
        android:valueFrom="0"
        android:valueTo="1"
        android:valueType="floatType" />
    <objectAnimator
        android:duration="510"
        android:startOffset="0"
        android:interpolator="@interpolator/bloom_overshoot"
        android:propertyName="scaleY"
        android:valueFrom="0"
        android:valueTo="1"
        android:valueType="floatType" />
</set>
